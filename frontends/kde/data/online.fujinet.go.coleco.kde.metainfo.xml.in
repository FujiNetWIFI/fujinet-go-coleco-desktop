<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>online.fujinet.go.coleco.kde</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>FujiNet Go ColecoVision (KDE)</name>
  <summary>A ColecoVision with a built-in FujiNet</summary>
  <description>
    <p>
      A self-contained ColecoVision with a FujiNet built in: browse a network
      host from the console, boot images over the network, and let the booted
      program keep talking to the network, all in one application.
    </p>
    <p>
      The emulated FujiNet cartridge runs the real cartridge firmware's own
      protocol sources, so it behaves exactly as the hardware does. An Opcode
      Super Game Module is fitted by default, and every ColecoVision cartridge
      mapper is supported.
    </p>
    <p>
      The ColecoVision BIOS is copyrighted firmware and is not included; it
      can be imported from the application on first run.
    </p>
  </description>
  <launchable type="desktop-id">online.fujinet.go.coleco.kde.desktop</launchable>
  <icon type="stock">online.fujinet.go.coleco.kde</icon>
  <!-- Software centres classify from these, not from the .desktop
       Categories= line; without them the app lands in no section at all. -->
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <url type="homepage">https://fujinet.online/</url>
  <url type="bugtracker">https://github.com/FujiNetWIFI/fujinet-go-coleco-desktop/issues</url>
  <developer id="online.fujinet">
    <name>FujiNet</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <caption>The FujiNet CONFIG client browsing network hosts from the console</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-coleco-desktop/v0.4.1/data/screenshots/kde/1_running_config.png</image>
    </screenshot>
    <screenshot>
      <caption>The built-in debugger's live VDP viewer</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-coleco-desktop/v0.4.1/data/screenshots/kde/2_vdp_debugger.png</image>
    </screenshot>
    <screenshot>
      <caption>Preferences</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-coleco-desktop/v0.4.1/data/screenshots/kde/3_preferences.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <!-- The CURRENT release templates its version from @PROJECT_VERSION@, so
         it cannot disagree with the tree; past releases are literal. The
         release job checks that this first entry is still a template. -->
    <release version="@PROJECT_VERSION@" date="2026-10-29">
      <description>
        <p>
          New: use an external FujiNet. A switch in Preferences makes the app connect to another FujiNet instance at a host:port you enter (for example 127.0.0.1:11502) instead of starting the built-in one.
        </p>
      </description>
    </release>
    <release version="0.4.2" date="2026-10-27">
      <description>
        <p>
          The Flatpak bundles now name Flathub as their runtime repository, so a downloaded bundle can fetch the GNOME or KDE runtime on a machine that has not set up Flathub.
        </p>
      </description>
    </release>
    <release version="0.4.1" date="2026-10-27">
      <description>
        <p>
          The Flatpak builds on the GNOME 51 runtime. The software-centre
          listing now credits FujiNet as developer, declares the app icon,
          and shows a full set of screenshots for each frontend.
        </p>
      </description>
    </release>
    <release version="0.4.0" date="2026-10-19">
      <description>
        <p>
          Debugger: a FujiNet tab shows every FujiBus packet between the
          ColecoVision's FujiNet cartridge and FujiNet, both ways, with hex.
        </p>
      </description>
    </release>
    <release version="0.3.1" date="2026-10-03">
      <description>
        <p>
          Games run at the correct speed again. The emulator was following
          the display's refresh ticks one frame per tick no matter how fast
          they came, so the KDE frontend — and any display faster than
          60 Hz — ran games at double speed or more. It now only locks to a
          display running close to the ColecoVision's own 59.92 Hz, and
          otherwise keeps its own time.
        </p>
      </description>
    </release>
    <release version="0.3.0" date="2026-09-08">
      <description>
        <p>
          The built-in FujiNet CONFIG is now the real one: WiFi setup with an
          on-screen keyboard, host slot renaming, a file browser with paging
          and a filter, host-to-host file copy, an adapter info screen, and a
          Game Lobby key — the complete fujinet-config ColecoVision port,
          replacing the bring-up stand-in.
        </p>
        <p>
          File copies between hosts no longer time out on large files: the
          cartridge grants COPY_FILE the same sixty-second budget as image
          mounts.
        </p>
        <p>
          A fresh install's second host slot now points at APPS.IRATA.ONLINE.
        </p>
      </description>
    </release>
    <release version="0.2.0" date="2026-09-07">
      <description>
        <p>
          Preferences in every frontend: the Super Game Module, palette,
          controller button swap, FujiNet, audio and gamepads are now
          settable from the application rather than only from the
          configuration file.
        </p>
        <p>
          A live FujiNet console log window, so the cartridge link and its
          transactions can be watched without leaving the application.
        </p>
        <p>
          Windows gains an installer, and the macOS bundle now carries the
          FujiNet runtime where the application actually looks for it.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-07">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
