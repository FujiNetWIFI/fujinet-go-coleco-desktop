<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>online.fujinet.go.coleco.kde</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>FujiNet Go ColecoVision</name>
  <summary>A ColecoVision with a built-in FujiNet</summary>
  <description>
    <p>
      A self-contained ColecoVision with a FujiNet built in: browse a network
      host from the console, boot images over the network, and let the booted
      program keep talking to the network, all in one application.
    </p>
    <p>
      The emulated FujiNet cartridge runs the real cartridge firmware's own
      protocol sources, so it behaves exactly as the hardware does. An Opcode
      Super Game Module is fitted by default, and every ColecoVision cartridge
      mapper is supported.
    </p>
    <p>
      The ColecoVision BIOS is copyrighted firmware and is not included; it
      can be imported from the application on first run.
    </p>
  </description>
  <launchable type="desktop-id">online.fujinet.go.coleco.kde.desktop</launchable>
  <url type="homepage">https://fujinet.online/</url>
  <url type="bugtracker">https://github.com/FujiNetWIFI/fujinet-go-coleco-desktop/issues</url>
  <developer id="online.fujinet">
    <name>Thomas Cherryhomes</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <caption>The FujiNet CONFIG client browsing network hosts from the console</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-coleco-desktop/main/data/screenshots/1_running_config.png</image>
    </screenshot>
    <screenshot>
      <caption>The built-in debugger's live VDP viewer</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-coleco-desktop/main/data/screenshots/2_vdp_debugger.png</image>
    </screenshot>
    <screenshot>
      <caption>Preferences</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-coleco-desktop/main/data/screenshots/3_preferences.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <!-- The CURRENT release templates its version from @PROJECT_VERSION@, so
         it cannot disagree with the tree; past releases are literal. The
         release job checks that this first entry is still a template. -->
    <release version="@PROJECT_VERSION@" date="2026-09-07">
      <description>
        <p>
          Preferences in every frontend: the Super Game Module, palette,
          controller button swap, FujiNet, audio and gamepads are now
          settable from the application rather than only from the
          configuration file.
        </p>
        <p>
          A live FujiNet console log window, so the cartridge link and its
          transactions can be watched without leaving the application.
        </p>
        <p>
          Windows gains an installer, and the macOS bundle now carries the
          FujiNet runtime where the application actually looks for it.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-07">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
