# Build trees. The negation matters: build-aux/ is SOURCE (flatpak manifests,
# the NSIS installer script), and "build*/" swallows it -- new manifests then
# never show up as untracked and quietly go missing from CI.
build*/
!build-aux/

# Provisioned dependencies. cmake/Dependencies.cmake fetches these at their
# pinned commits, so they are build output, not source -- and committing them
# as bare gitlinks (which `git add -A` will happily do once they exist
# locally) is worse than not tracking them at all: with no .gitmodules a
# clone gets empty directories, and an empty directory is indistinguishable
# from a populated one except by the SENTINEL test (PORTING.md 10.4).
third_party/

# Staged sources: produced by cmake/StageAdamcore.cmake and
# cmake/StageFujiProto.cmake from the pinned dependencies. Never edit these;
# edit the source checkout and re-stage with -DADAMCORE_RESTAGE=ON /
# -DFUJI_RESTAGE=ON.
core/adamcore-generated/
core/coleco/fuji-generated/

# FujiNet runtime build tree (tools/fujinet/build-fujinet-desktop.sh).
tools/fujinet/work/

# The ColecoVision BIOS is copyrighted Coleco firmware and is not
# redistributed here (COMPLIANCE.md). A local copy for -DWITH_COLECO_ROMS=ON
# development lives in tools/roms/ and must never be committed.
tools/roms/*.rom
tools/roms/*.bin
tools/roms/*.col

# Cartridge images.
*.rom
*.col
!core/tests/**/*.rom

.cache/
compile_commands.json
.flatpak-builder/
__pycache__/
*.pyc
